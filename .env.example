# ==========================================
# AGRIMAX BACKEND - Environment Variables
# Copy this file to .env and fill in values
# ==========================================

# 1. Database Configuration (Neon PostgreSQL)
DB_URL=jdbc:postgresql://your-neon-host/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your-db-password-here

# 2. Security (JWT Token Secret — must be Base64-encoded, at least 256 bits)
# Generate with: openssl rand -base64 64
JWT_SECRET=your-base64-jwt-secret-here

# 3. AI Integration (Gemini API)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# 4. Groq API (Optional — fast LLM & Whisper STT fallback)
GROQ_API_KEY=your-groq-api-key-here

# 5. OpenAI API (Optional — Whisper fallback)
OPENAI_API_KEY=your-openai-api-key-here

# 6. Azure Cognitive Services (Optional — Text-to-Speech)
AZURE_TTS_API_KEY=your-azure-tts-api-key-here
AZURE_TTS_REGION=eastus

# 7. SMTP Mail Configuration (Email verification & password reset)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password

# 8. Bootstrap Admin Configuration
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_EMAIL=admin@agrimax.local
ADMIN_PASSWORD=Admin@1234

# 9. Rate Limiting (true/false)
RATE_LIMIT_ENABLED=true

# 10. CORS (comma-separated allowed origins)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
