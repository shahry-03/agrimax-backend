# ==========================================
# AGRIMAX BACKEND - Environment Variables
# Copy this file to .env and fill in values
# ==========================================

# 1. Database Configuration (Neon PostgreSQL)
DB_URL=jdbc:postgresql://your-neon-host/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your-db-password-here

# 2. Security (JWT Token Secret — must be Base64-encoded, at least 256 bits)
# Generate with: openssl rand -base64 64
JWT_SECRET=your-base64-jwt-secret-here

# 3. AI Integration (Gemini API)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# 4. CORS (comma-separated allowed origins)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
